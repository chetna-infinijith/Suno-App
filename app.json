{
  "expo": {
    "ios": {
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to securely recognize user speech.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access the microphone for recording audio.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "buildNumber": "1.0.0",
      "supportsTablet": false,
      "bundleIdentifier": "com.assnippet.suno",
      "usesIcloudStorage": false,
      "userInterfaceStyle": "light",
      "googleServicesFile": "./GoogleService-Info.plist",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "DDA9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "web": {},
    "icon": "./assets/app/app_icon.png",
    "name": "Suno Mobile",
    "slug": "suno-mobile",
    "extra": {
      "eas": {
        "projectId": "eea0fa8b-3653-4205-a9ec-f8f988040b4b"
      }
    },
    "scheme": "com.assnippet.suno",
    "splash": {
      "image": "./assets/app/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#551658"
    },
    "android": {
      "package": "com.assnippet.suno",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "versionCode": 1,
      "adaptiveIcon": {},
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "userInterfaceStyle": "light",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access the camera to capture and scan documents."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access the microphone for recording audio.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to securely recognize user speech."
        }
      ],
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access the microphone for recording audio.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to securely recognize user speech."
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "config": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      [
        "@react-native-firebase/crashlytics",
        {
          "debug": false
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "privacy": "unlisted",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "description": "Suno Mobile app powered by Draftbit",
    "orientation": "portrait",
    "iosStatusBar": {},
    "notification": {
      "androidMode": "default"
    },
    "backgroundColor": "#551658",
    "allowFontScaling": true,
    "androidStatusBar": {},
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "androidNavigationBar": {},
    "owner": "suno-software"
  }
}
